# ============================================
# AI YOUTUBE AUTOMATION AGENT - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control

# ============================================
# OpenAI / ChatGPT Configuration
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7

# ============================================
# YouTube API Configuration
# ============================================
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# ============================================
# Google Cloud Configuration
# ============================================
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id_here
GOOGLE_APPLICATION_CREDENTIALS=config/google-credentials.json

# ============================================
# Speech-to-Text Configuration
# Choose one: GOOGLE or ASSEMBLYAI
# ============================================
SPEECH_TO_TEXT_PROVIDER=google
GOOGLE_SPEECH_API_KEY=your_google_speech_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ============================================
# Video Generation Configuration
# To be determined based on API availability
# ============================================
VIDEO_GENERATION_PROVIDER=google_vertex_ai
VIDEO_GENERATION_API_KEY=your_video_generation_api_key_here

# ============================================
# Thumbnail Generation Configuration
# ============================================
THUMBNAIL_GENERATOR=dall_e
DALL_E_MODEL=dall-e-3
THUMBNAIL_SIZE=1280x720

# ============================================
# Application Configuration
# ============================================
APP_NAME=AI YouTube Automation Agent
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG_MODE=False

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=sqlite:///./data/automation.db
DATABASE_ECHO=False

# ============================================
# Video Upload Configuration
# ============================================
VIDEO_PRIVACY_STATUS=private
VIDEO_DEFAULT_LANGUAGE=en
VIDEO_UPLOAD_TIMEOUT=600
VIDEO_MAX_RETRIES=3

# ============================================
# Scheduling Configuration
# ============================================
SCHEDULER_ENABLED=True
SCHEDULER_TIMEZONE=UTC

# ============================================
# File Paths
# ============================================
TEMP_DIR=./temp
LOGS_DIR=./logs
DATA_DIR=./data
OUTPUT_DIR=./output

# ============================================
# API Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# ============================================
# Proxy Configuration (Optional)
# ============================================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

{
  "openai": {
    "api_key": "YOUR_OPENAI_API_KEY_HERE",
    "organization_id": "YOUR_ORGANIZATION_ID_HERE (optional)"
  },
  "youtube": {
    "client_id": "YOUR_YOUTUBE_CLIENT_ID_HERE",
    "client_secret": "YOUR_YOUTUBE_CLIENT_SECRET_HERE",
    "refresh_token": "YOUR_YOUTUBE_REFRESH_TOKEN_HERE",
    "channel_id": "YOUR_YOUTUBE_CHANNEL_ID_HERE"
  },
  "google_cloud": {
    "project_id": "YOUR_GCP_PROJECT_ID_HERE",
    "credentials_file": "path/to/google-credentials.json"
  },
  "speech_to_text": {
    "provider": "google",
    "google": {
      "api_key": "YOUR_GOOGLE_SPEECH_API_KEY_HERE"
    },
    "assemblyai": {
      "api_key": "YOUR_ASSEMBLYAI_API_KEY_HERE"
    }
  },
  "video_generation": {
    "provider": "google_vertex_ai",
    "api_key": "YOUR_VIDEO_GENERATION_API_KEY_HERE"
  },
  "thumbnail_generation": {
    "provider": "dall_e",
    "api_key": "YOUR_DALL_E_API_KEY_HERE"
  }
}
